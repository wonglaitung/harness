{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "git *": "allow",
      "uv *": "allow",
      "uvx *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "gradle *": "allow",
      "snap run *": "allow",
      "java *": "allow",
      "javac *": "allow",
      "./gradlew *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "PYTHONPATH=*": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "kill *": "allow",
