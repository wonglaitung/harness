/* Harness Client - Main Stylesheet */

/* Global */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #333;
}

/* Main Window */
QMainWindow {
    background-color: #f5f5f5;
}

/* Groups */
QGroupBox {
    font-weight: bold;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #333;
}

/* Buttons */
QPushButton {
    background-color: #f0f0f0;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 28px;
    color: #333;
}

QPushButton:hover {
    background-color: #e5e5e5;
    border-color: #c0c0c0;
}

QPushButton:pressed {
    background-color: #d5d5d5;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #999;
}

/* Primary button */
QPushButton[primary="true"] {
    background-color: #0078d4;
    color: white;
    border-color: #0078d4;
}

QPushButton[primary="true"]:hover {
    background-color: #106ebe;
}

/* Input fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: white;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px;
    color: #333;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078d4;
}

/* List widgets */
QListWidget {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    color: #333;
}

QListWidget::item {
    padding: 6px;
    border-bottom: 1px solid #f0f0f0;
}

QListWidget::item:selected {
    background-color: #e5f3ff;
    color: #333;
}

QListWidget::item:hover {
    background-color: #f5f5f5;
}

/* Combo box */
QComboBox {
    background-color: white;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 12px;
    color: #333;
}

QComboBox::drop-down {
    border: none;
}

/* Scroll bar */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

/* Status bar */
QStatusBar {
    background-color: #f0f0f0;
    border-top: 1px solid #e0e0e0;
    color: #333;
}

/* Menu Bar - 关键修复 */
QMenuBar {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
    color: #333;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    color: #333;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #e5f3ff;
    color: #333;
}

QMenuBar::item:pressed {
    background-color: #cce4f7;
    color: #333;
}

/* Menu - 下拉菜单 */
QMenu {
    background-color: white;
    border: 1px solid #e0e0e0;
    color: #333;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #333;
    padding: 6px 32px 6px 20px;
}

QMenu::item:selected {
    background-color: #e5f3ff;
    color: #333;
}

QMenu::item:disabled {
    color: #999;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* Tool bar */
QToolBar {
    background-color: #f8f8f8;
    border-bottom: 1px solid #e0e0e0;
    spacing: 6px;
    padding: 4px;
}

QToolBar QToolButton {
    color: #333;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}

QToolBar QToolButton:hover {
    background-color: #e5e5e5;
    border-color: #d0d0d0;
}

QToolBar QToolButton:pressed {
    background-color: #d5d5d5;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    color: #333;
}

QTabBar::tab:selected {
    background-color: white;
    color: #333;
}

QTabBar::tab:hover {
    background-color: #e5e5e5;
}

/* Dialog */
QDialog {
    background-color: #f5f5f5;
    color: #333;
}

/* Labels */
QLabel {
    color: #333;
}

/* CheckBox */
QCheckBox {
    color: #333;
}

/* SpinBox */
QSpinBox {
    background-color: white;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px;
    color: #333;
}

/* TextBrowser */
QTextBrowser {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    color: #333;
}

/* Splitter */
QSplitter {
    background-color: #f5f5f5;
}

QSplitter::handle {
    background-color: #e0e0e0;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}
