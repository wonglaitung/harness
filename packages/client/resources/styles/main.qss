/* Harness Client - Dark Theme (Hermes Style) */

/* Global */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #d4d4d4;
}

/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
}

/* Groups */
QGroupBox {
    font-weight: bold;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #171717;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #808080;
}

/* Buttons */
QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 28px;
    color: #d4d4d4;
}

QPushButton:hover {
    background-color: #3e3e3e;
    border-color: #505050;
}

QPushButton:pressed {
    background-color: #4e4e4e;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #666;
}

/* Primary button */
QPushButton[primary="true"] {
    background-color: #0078d4;
    color: white;
    border-color: #0078d4;
}

QPushButton[primary="true"]:hover {
    background-color: #106ebe;
}

QPushButton[primary="true"]:pressed {
    background-color: #005a9e;
}

/* Input fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 6px;
    color: #d4d4d4;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078d4;
}

/* List widgets */
QListWidget {
    background-color: #171717;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #d4d4d4;
}

QListWidget::item {
    padding: 6px;
    border-bottom: 1px solid #2a2a2a;
}

QListWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #2a2a2a;
}

/* Combo box */
QComboBox {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 6px 12px;
    color: #d4d4d4;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #d4d4d4;
    selection-background-color: #094771;
}

/* Scroll bar */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #505050;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #505050;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status bar - VS Code style accent */
QStatusBar {
    background-color: #007acc;
    border-top: none;
    color: #ffffff;
}

/* Menu Bar */
QMenuBar {
    background-color: #2d2d30;
    border-bottom: 1px solid #3e3e42;
    color: #d4d4d4;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    color: #d4d4d4;
    padding: 4px 8px;
}

QMenuBar::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #0078d4;
    color: #ffffff;
}

/* Menu - Dropdown menus */
QMenu {
    background-color: #252526;
    border: 1px solid #3e3e42;
    color: #d4d4d4;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #d4d4d4;
    padding: 6px 32px 6px 20px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #666;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 4px 8px;
}

/* Tool bar */
QToolBar {
    background-color: #2d2d30;
    border-bottom: 1px solid #3e3e42;
    spacing: 6px;
    padding: 4px;
}

QToolBar QToolButton {
    color: #d4d4d4;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}

QToolBar QToolButton:hover {
    background-color: #3e3e3e;
    border-color: #505050;
}

QToolBar QToolButton:pressed {
    background-color: #4e4e4e;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    color: #808080;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

QTabBar::tab:hover:!selected {
    background-color: #3e3e3e;
    color: #d4d4d4;
}

/* Dialog */
QDialog {
    background-color: #1e1e1e;
    color: #d4d4d4;
}

/* Labels */
QLabel {
    color: #d4d4d4;
    background-color: transparent;
}

/* CheckBox */
QCheckBox {
    color: #d4d4d4;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border: 1px solid #0078d4;
    border-radius: 3px;
}

/* SpinBox */
QSpinBox {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 4px;
    padding-right: 20px;
    color: #d4d4d4;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #3e3e42;
    border-top-right-radius: 4px;
    background-color: #2d2d30;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #3e3e42;
    border-bottom-right-radius: 4px;
    background-color: #2d2d30;
}

QSpinBox::up-arrow {
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #3e3e3e;
}

/* TextBrowser */
QTextBrowser {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    color: #d4d4d4;
    padding: 8px;
}

/* Splitter */
QSplitter {
    background-color: #1e1e1e;
}

QSplitter::handle {
    background-color: #3e3e42;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* ScrollArea */
QScrollArea {
    background-color: #1e1e1e;
    border: none;
}

/* ToolTip */
QToolTip {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    padding: 4px;
    border-radius: 4px;
}

/* ProgressDialog */
QProgressBar {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    text-align: center;
    color: #d4d4d4;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* MessageBox colors (inherits from QDialog) */
QMessageBox {
    background-color: #1e1e1e;
}

QMessageBox QLabel {
    color: #d4d4d4;
}