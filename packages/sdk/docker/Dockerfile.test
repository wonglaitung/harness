# Dockerfile for testing Harness Agent Service
#
# This image is used for integration testing with Spring Cloud components.

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY packages/sdk/pyproject.toml packages/sdk/README.md ./
COPY packages/sdk/src ./src

# Install SDK with all optional dependencies
RUN pip install --no-cache-dir \
    -e ".[service,redis,prometheus,dev]" \
    aiohttp \
    redis

# Copy test files
COPY packages/sdk/tests ./tests

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the service
CMD ["uvicorn", "harness.service:app", "--host", "0.0.0.0", "--port", "8000"]